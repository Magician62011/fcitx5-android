<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Allow cleartext (plain HTTP) traffic to Sogou cloud pinyin API.
      Android 9+ blocks cleartext HTTP by default; this overrides that
      restriction for this specific domain only.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">shouji.sogou.com</domain>
    </domain-config>
</network-security-config>
